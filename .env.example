# Database — local SQLite file via libSQL
DATABASE_URL="file:./data/lumen.db"

# Google OAuth 2.0. Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Real-time push (optional). Gmail can notify this app when a mailbox changes
# instead of waiting for the next poll. Both values are required to turn it on;
# with either missing, Lumen simply polls.
#
#   GOOGLE_PUBSUB_TOPIC  full topic name, e.g. projects/my-project/topics/lumen-gmail
#   GMAIL_PUSH_TOKEN     long random secret; it is part of the webhook URL
#
# Setup: create the topic in Google Cloud, grant
# gmail-api-push@system.gserviceaccount.com the "Pub/Sub Publisher" role on it,
# and add a push subscription pointing at
# https://your-host/webhooks/gmail?token=<GMAIL_PUSH_TOKEN>
GOOGLE_PUBSUB_TOPIC=""
GMAIL_PUSH_TOKEN=""

# Microsoft identity platform (Outlook.com / Microsoft 365).
# Register at https://entra.microsoft.com → App registrations, with this redirect
# URI: http://localhost:3000/auth/microsoft/callback
# `common` accepts work/school and personal accounts; use a tenant id to pin one.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
# MICROSOFT_REDIRECT_URI="http://localhost:3000/auth/microsoft/callback"

# 32-byte key (hex or base64) used to AES-256-GCM encrypt OAuth refresh tokens at rest.
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# AI services (Jev + an LLM) are configured in the app UI (Settings), not here.
# Their keys are stored encrypted at rest, the same as the Google refresh token.

# Optional. Only needed once ReUI premium blocks/icons are in use — see PLAN.md.
# REUI_LICENSE_KEY=""

# First-account bootstrap (optional).
# If both are set and no user exists yet, the first request to the app creates this
# account automatically — useful for a fresh local install or a single-user deploy.
# Create the password with at least 10 characters; it is hashed with argon2id.
LUMEN_DEFAULT_USER_EMAIL=""
LUMEN_DEFAULT_USER_PASSWORD=""