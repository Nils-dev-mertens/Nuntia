# Database — local SQLite file via libSQL
DATABASE_URL="file:./data/lumen.db"

# Google OAuth 2.0. Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 32-byte key (hex or base64) used to AES-256-GCM encrypt OAuth refresh tokens at rest.
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Decision layer. MVP uses structured output; see PLAN.md for the Jev swap.
DECISION_MODEL="gemini-2.5-flash"
GEMINI_API_KEY=""

# Optional. Only needed once ReUI premium blocks/icons are in use — see PLAN.md.
# REUI_LICENSE_KEY=""