# Database — local SQLite file via libSQL
DATABASE_URL="file:./data/lumen.db"

# Google OAuth 2.0. Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Real-time push (optional). Gmail can notify this app when a mailbox changes
# instead of waiting for the next poll. Both values are required to turn it on;
# with either missing, Nuntia simply polls.
#
#   GOOGLE_PUBSUB_TOPIC  full topic name, e.g. projects/my-project/topics/nuntia-gmail
#   GMAIL_PUSH_TOKEN     long random secret; it is part of the webhook URL
#
# Setup: create the topic in Google Cloud, grant
# gmail-api-push@system.gserviceaccount.com the "Pub/Sub Publisher" role on it,
# and add a push subscription pointing at
# https://your-host/webhooks/gmail?token=<GMAIL_PUSH_TOKEN>
GOOGLE_PUBSUB_TOPIC=""
GMAIL_PUSH_TOKEN=""

# Microsoft identity platform (Outlook.com / Microsoft 365).
# Register at https://entra.microsoft.com → App registrations, with this redirect
# URI: http://localhost:3000/auth/microsoft/callback
# `common` accepts work/school and personal accounts; use a tenant id to pin one.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
# MICROSOFT_REDIRECT_URI="http://localhost:3000/auth/microsoft/callback"

# 32-byte key (hex or base64) used to AES-256-GCM encrypt OAuth refresh tokens at rest.
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# AI services (Jev + an LLM) are configured in the app UI (Settings), not here.
# Their keys are stored encrypted at rest, the same as the Google refresh token.

# Operations.
#
# Request and error log. One JSON line per event, rotated at ~2 MB. Invite codes
# are redacted and query strings are dropped before anything is written.
APP_LOG_DIR="data/logs"
#
# Database snapshots (`bun run scripts/backup-db.ts`). Put this on a different
# disk from data/ if you can: a backup beside the database survives a bad
# migration, not a dead machine.
BACKUP_DIR="data/backups"
BACKUP_KEEP="14"

# Optional. Only needed once ReUI premium blocks/icons are in use — see PLAN.md.
# REUI_LICENSE_KEY=""

# Access
#
# `invite` (the beta default) closes open registration: an invite code is what
# creates an account and `/request-access` is the way to ask for one. Signing in
# with an address and password works either way. `login` restores open sign-up.
LUMEN_ACCESS_MODE="invite"
#
# The public origin invitations point at. Not derived from the request: behind a
# reverse proxy that is the internal address, and a wrong host in a copied link
# is not something the recipient can work around.
LUMEN_APP_URL="http://localhost:3000"
#
# Comma-separated operator addresses. They may open /admin and use
# /admin/sign-in even in invite mode. The first user on an empty install is an
# admin already; this list is the break-glass path.
LUMEN_ADMIN_EMAILS=""
#
# A code that may sign the very first user in on an empty install — otherwise
# nobody can open /admin to issue the first invite. Any 12-character Crockford
# base32 string works (no I, L, O or U); it is ignored once a user exists.
LUMEN_BOOTSTRAP_INVITE=""
#
# Which connected mailbox sends approval emails. Defaults to the operator's first
# mailbox; with none connected, /admin shows the link to copy instead.
LUMEN_INVITE_SENDER=""

# First-account bootstrap (optional, works in invite mode too).
# If both are set and no user exists yet, the first request to the app creates this
# account as the admin — useful for a fresh local install or a single-user deploy,
# and the way to have an account to sign in with on a beta install. Create the
# password with at least 10 characters; it is hashed with argon2id.
# Only the first user comes from here: once anyone exists these are ignored.
LUMEN_DEFAULT_USER_EMAIL=""
LUMEN_DEFAULT_USER_PASSWORD=""