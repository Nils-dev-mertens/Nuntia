# The app the landing page sends people to.
# Local development default, and the value a deployment should override.
PUBLIC_APP_URL="http://localhost:3000"

# The public origin of this landing site. It is used in the canonical link,
# the social share image URL and the generated robots.txt/sitemap.xml.
# A deployment should set its real origin; this is the fallback.
PUBLIC_SITE_URL="https://nuntia.app"
