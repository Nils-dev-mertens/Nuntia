---
/**
 * The landing page.
 *
 * The hero and its interactive demo are kept from the Stitch layout. Everything
 * below it is written as information rather than as a pitch: what Nuntia is and
 * what it needs, how a thread is read, what it knows about the people you write
 * to, what the optional AI helpers and connected agents do, where the mail lives,
 * what is not built yet, and what you need to start.
 *
 * Style follows `stitch/DESIGN.md`: obsidian canvas, hairline rules, flat
 * blocks, one cadmium accent, Space Grotesk headings and JetBrains Mono labels.
 * The mock-up's gradients, badges (SOC 2, "zero training") and "real-time" or
 * "end-to-end encrypted" claims are deliberately absent, because the product has
 * none of them. Every claim below comes from `docs/landing-page-info.md` and the
 * contacts features in `src/lib/contacts/`.
 *
 * Everything here is static HTML; the only island is the hero visual.
 */
import SiteLayout from '../layouts/SiteLayout.astro'
import HeroVisual from '../components/HeroVisual'

const appUrl = (import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:3000').replace(
  /\/$/,
  '',
)

const pageDescription =
  'Nuntia is a private-beta mail client for Gmail and Outlook: one inbox, threads read as conversations, four states that say what needs you, a directory of the people you write to, optional AI drafts you review, and your own MCP agent that can read and triage the same mail with your approval. Nothing is sent without you.'

const specs = [
  { label: 'Works with', value: 'Gmail and Outlook (Microsoft 365 or outlook.com). One or more addresses, in one inbox.' },
  { label: 'Runs in', value: 'The browser. No phone app, no desktop app, no extension.' },
  { label: 'Status', value: 'Private beta. You request access, a person reviews it, and the invite link works once.' },
  { label: 'Price', value: 'None set. There is no payment step anywhere in the app.' },
  { label: 'AI', value: 'Optional. You connect your own account with Anthropic, OpenAI or Google.' },
  { label: 'Agents', value: 'Optional. Claude Code, Cursor, VS Code, Vibe and other MCP clients connect over a loopback-only service, using a token you can revoke. They read only mail Nuntia has already synced.' },
  { label: 'Storage', value: 'One file on the machine where Nuntia runs, plus the original in Gmail or Outlook.' },
  { label: 'Permissions', value: 'Read mail, send mail, mark it read. Nuntia cannot delete anything.' },
]

const audience = [
  {
    title: 'Two or more addresses',
    body: 'A work Gmail and a personal Outlook, read in one place. When the same conversation reaches both, it shows up once.',
  },
  {
    title: 'A thread pile',
    body: 'The inbox is a list of threads, and the real question is whether this one needs an answer from you. Four states answer that.',
  },
  {
    title: 'AI, on your terms',
    body: 'You want help, but with your own key, seeing the result before it is used, and keeping the last word.',
  },
]

const steps = [
  {
    number: '01',
    title: 'Connect a mailbox',
    body: 'Sign in with Google or Microsoft and approve read, send and mark-read access. The first connection brings in the last thirty days; older mail is not fetched.',
  },
  {
    number: '02',
    title: 'Let the rules sort',
    body: 'Built-in rules place each thread in one of four states, and they win where they apply. An optional AI key adds importance, urgency, and the cases the rules cannot decide. Your own choice outranks both.',
  },
  {
    number: '03',
    title: 'Read, then reply',
    body: 'Your greeting, signature and the quoted original are put back on send. A suggested reply, if you ask for one, waits in the box to edit. Nothing is sent without you.',
  },
]

const triage = [
  {
    state: 'Needs action',
    what: 'Priya needs the signed NDA resent',
    tone: 'border-primary/40 bg-primary/10 text-primary',
  },
  {
    state: 'Waiting for reply',
    what: 'Quote sent to Northwind; answer due in two weeks',
    tone: 'border-warning/40 bg-warning/10 text-warning',
  },
  {
    state: 'Information',
    what: 'Site notes from the contractor; no decision needed',
    tone: 'border-border bg-muted text-muted-foreground',
  },
  {
    state: 'Low priority',
    what: 'A newsletter you keep for later',
    tone: 'border-border bg-muted text-muted-foreground/70',
  },
]

const searchHits = [
  { subject: 'NDA — signed copy for Northwind', who: 'Priya Raman', tag: 'client' },
  { subject: 'Retainer quote, first quarter', who: 'Piet Bakker', tag: 'supplier' },
  { subject: 'Monthly update to investors', who: 'Ana de Vries', tag: 'investor' },
]

const peopleNotes = [
  {
    title: 'A profile you write, or one Nuntia drafts',
    body: 'Role and company, how you know the person, what you usually talk about, what they are working on, and a sentence or two summarising your history. Nuntia can draft it from the correspondence; you edit it.',
  },
  {
    title: 'A change log with Undo',
    body: 'Every note Nuntia writes is stored as a revision with what changed and an Undo, the last twenty per person. It never overwrites a field you wrote yourself.',
  },
  {
    title: 'Importance from 1 to 10',
    body: 'Your rating counts when Nuntia decides how much attention a thread deserves. That is one of the few things a person can tell the app that the mail cannot.',
  },
  {
    title: 'A directory that works like one',
    body: 'Alphabetical, not by recency. Press / to search, filter by tag or by company, and open one person to see every stored thread they appear on and their colleagues at the same address.',
  },
  {
    title: 'Companies come from the address',
    body: 'Addresses at one domain are grouped, and the one-line description of what the company does is yours — or one you accept from a signature in the mail. It is never guessed from the domain.',
  },
  {
    title: 'A desk is not a person',
    body: 'support@, billing@ and info@ never get a person tag automatically. The mail stays in the inbox; only the label meant for a person is withheld.',
  },
]

const aiCards = [
  {
    label: 'The decision helper',
    title: 'Scores, not sentences',
    body: 'For each thread it asks how important this is, how urgent, whether a reply is possible at all, and which state it belongs in when the rules cannot tell. It returns a score, not prose.',
    footnote: 'Importance · urgency · replyability',
    accent: 'bg-primary',
  },
  {
    label: 'The writing helper',
    title: 'Words, when you ask',
    body: 'It names what a thread is about, drafts the notes about a person, suggests tags and writes tag descriptions, and proposes a reply. All of it lands as text you can edit.',
    footnote: 'Topic · notes · tags · drafts',
    accent: 'bg-warning',
  },
  {
    label: 'The boundaries',
    title: 'Rules first, you last',
    body: 'The helpers never send, never decide that a thread is Done, and never override the built-in rules. The AI log records the service, model, outcome and duration — never the mail.',
    footnote: 'No auto-send · no message text in logs',
    accent: 'bg-success',
  },
]

const agentSteps = [
  'The MCP service runs beside Nuntia: Docker Compose starts it with the app; from a source checkout, run bun run mcp.',
  'Create a token in Settings → AI agents. It is shown once and can be revoked at any time.',
  'Paste the generated command or JSON into your client, restart it, and ask about a thread.',
]

const agentClients = ['Claude Code', 'Cursor', 'VS Code', 'Vibe', 'Claude Desktop']

const agentTools = [
  { name: 'list_threads', detail: 'state: needs action · query: Northwind', result: '2 threads' },
  { name: 'get_thread', detail: 'thread: NDA — signed copy', result: '5 messages · 1 attachment' },
  { name: 'get_person', detail: 'priya@northwind.com', result: 'client · importance 8 / 10' },
  { name: 'draft_reply', detail: 'thread: NDA — signed copy', result: 'draft returned · not stored' },
]

const agentConfig = `{
  "mcpServers": {
    "nuntia": {
      "url": "http://127.0.0.1:3333/mcp",
      "headers": {
        "Authorization": "Bearer mcp_<id>.<secret>"
      }
    }
  }
}`

const agentCards = [
  {
    label: 'Read',
    tools: 'list_threads · get_thread · search_mail',
    title: 'Search and open mail',
    body: 'List threads by state, folder, correspondent, tag or words; open one with its messages, attachment details and your notes. Search every folder.',
  },
  {
    label: 'Context',
    tools: 'get_person · list_tags · list_states',
    title: 'See the people behind it',
    body: 'A correspondent’s notes, tags and recent threads, the tag vocabulary, your four states in your own wording, and the rules that file mail.',
  },
  {
    label: 'Triage',
    tools: 'move_thread',
    title: 'Move and sort',
    body: 'Set a thread’s state, move it between inbox, archive, trash and spam, or both. The same override you can make, and it survives the next sync.',
  },
  {
    label: 'People',
    tools: 'update_person_tags · update_person_notes',
    title: 'Keep notes current',
    body: 'Add or remove a person’s tags, or update their role, relationship, topics, current work and importance. Only the fields the agent supplies change.',
  },
  {
    label: 'Draft',
    tools: 'draft_reply',
    title: 'Draft, never send',
    body: 'Ask for a reply and the agent gets text to show you. Nothing is stored in Nuntia and nothing leaves the mailbox.',
  },
  {
    label: 'Send',
    tools: 'send_reply · confirm: true',
    title: 'One approval, then send',
    body: 'A reply goes out from the mailbox that owns the thread only after you approve the exact body and the agent confirms. A single accidental call is refused.',
  },
]

const agentFacts = [
  ['Endpoint', '127.0.0.1:3333/mcp · Streamable HTTP'],
  ['Credential', 'One token per agent, revocable in Settings'],
  ['Scope', 'Stored mail, people and triage — no sync, no attachments'],
  ['Sending', 'Only after you approve the exact body'],
]

const privacyCards = [
  {
    title: 'Your provider stays the source of truth',
    body: 'Mail is read and sent through Gmail or Outlook. Nuntia keeps a copy in one file on the machine where it runs, which is what makes reading and search fast — and it cannot delete anything, there or in your mailbox.',
    footnote: 'Read and send access · no delete',
    accent: 'bg-primary',
  },
  {
    title: 'Keys are locked, not shared',
    body: 'Your Google or Microsoft sign-in and your AI key are encrypted at rest with a key the person running Nuntia holds. Mail is cleaned before it is shown: scripts removed, and the message walled off from the rest of the page.',
    footnote: 'Encrypted at rest · sanitised mail',
    accent: 'bg-warning',
  },
  {
    title: 'What leaves the machine, and when',
    body: 'Mail is read from and sent to Google or Microsoft. Text goes to your AI provider only when a helper is switched on. A Gravatar photo is requested only if you turn photos on. Nothing else is sent anywhere.',
    footnote: 'Three destinations, no tracking',
    accent: 'bg-success',
  },
]

const limited = [
  'Only Gmail and Outlook. No other mail providers.',
  'No spam handling, spam rules or deleted-mail view.',
  'No phone app and no desktop app. It runs in the browser.',
  'No shared workspace for a team. Everyone has their own.',
  'No calendar, and no address book imported from Google or Microsoft.',
  'No scheduled sending and no automatic replies.',
  'AI needs your own key. There is no included model.',
  'Tags show on threads but do not change a suggested reply yet; only the topic and your goal do.',
  'Mail is not instant unless Gmail’s extra setup is done.',
  'Agents read only the mail Nuntia has already synced. They do not fetch from Gmail or Outlook, and they cannot read attachment contents.',
  'The agent service listens on the local machine only, and every client needs a token created in Settings.',
]

const betaSteps = [
  'You ask for access with a short form.',
  'A person running the beta reviews the request and approves it.',
  'You receive an email with a link that works once.',
  'You choose a password, connect a mailbox, and you are in. After that you sign in with your address and password.',
]

const needs = [
  'A Gmail or Outlook address — one of them is enough.',
  'An invitation from whoever runs the Nuntia you are joining, or a computer of your own to run it on.',
  'To run your own: a small app registration with Google or Microsoft, once, so they know Nuntia may connect. The setup guides walk through it and it takes a few minutes per provider.',
  'The first connection brings in the last thirty days of mail. New mail is checked on a timer; with extra setup, Gmail can say the moment something arrives.',
  'For an agent: the MCP service runs with Docker Compose, or you start it from a source checkout. Create a token in Settings → AI agents and paste the generated config into your client.'
]

const faqs = [
  {
    question: 'Which mail accounts work?',
    answer:
      'Gmail and Outlook — a personal Outlook.com address or a Microsoft 365 work account. You can connect more than one, from either service, and read them in one inbox. Mail from another provider is not supported.',
  },
  {
    question: 'Where does my mail live?',
    answer:
      'Your provider keeps the original. Nuntia keeps a copy in one file on the machine where it runs, which is what makes search and reading fast. Google or Microsoft sign-ins and AI keys are stored locked. Nuntia asks for read and send access and cannot delete mail.',
  },
  {
    question: 'What do the notes about people contain?',
    answer:
      'Role and company, how you know them, what you usually talk about, what they are working on, and a short summary of your history. You write them or let Nuntia draft them, and it tracks which fields it wrote so it never overwrites yours. Every automatic change can be undone.',
  },
  {
    question: 'Can I import my address book?',
    answer:
      'No. There is no import from Google or Microsoft, and no calendar. The directory is built from the mail itself: a person appears once you have exchanged mail with them. Companies are read from the domain of the address, not from a stored company record.',
  },
  {
    question: 'Does it ever send without me?',
    answer:
      'No. A suggested reply is placed in the reply box for you to edit, and it is not saved anywhere. There is no automatic reply and no scheduled send.',
  },
  {
    question: 'Do I need an AI key?',
    answer:
      'No. Without one, Nuntia still sorts mail by its built-in rules and reply composition works fully. With a key from Anthropic, OpenAI or Google, it can also score importance, name topics, keep notes on people, suggest tags, draft tag descriptions and propose replies.',
  },
  {
    question: 'Can I connect my own AI agent?',
    answer:
      'Yes. Nuntia includes an MCP service, and Docker Compose starts it with the app. Claude Code, Cursor, VS Code, Vibe and other MCP clients can read the mail Nuntia has already synced, look up people, tags and states, move threads, update notes and tags, and draft replies. You create a token in Settings → AI agents and can revoke it there. An agent cannot send without your approval: the send tool refuses unless it is called again with explicit confirmation after you have seen the exact body. The service listens on the local machine only and does not fetch new mail.'
  },
  {
    question: 'Can I run it myself?',
    answer:
      'Yes. The project ships as a Docker image and needs a small app registration with Google or Microsoft so those services accept the connection. The first sync brings in the last thirty days. New mail is checked on a timer, or pushed the moment it arrives once Gmail’s extra setup is done.',
  },
  {
    question: 'What does it not do yet?',
    answer:
      'No other mail providers, no spam handling or deleted-mail view, no phone or desktop app, and no shared workspace for a team. There is no calendar, no contact import from Google or Microsoft, no scheduled sending and no automatic replies. An agent reads only stored mail, cannot open attachments, and needs a token created in Settings.',
  },
]
---

<SiteLayout
  title="Nuntia — read email like chat"
  description={pageDescription}
  shareDescription="One inbox for Gmail and Outlook. Threads as conversations, four states, notes on the people you write to, AI drafts you approve, and your own agent over MCP."
  path="/"
>
    <main>
      <!-- Hero -->
      <section
        class="relative overflow-x-clip border-b border-border px-5 pt-16 pb-14 md:px-12 md:pt-24 md:pb-20"
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-[420px] max-w-4xl bg-[radial-gradient(ellipse_at_top,rgba(255,87,34,0.16),rgba(255,160,0,0.05)_45%,transparent_70%)]"
        >
        </div>

        <div class="mx-auto flex max-w-5xl flex-col items-center text-center">
          <h1
            class="rise-late max-w-4xl font-display text-[40px] leading-[1.03] font-semibold tracking-[-0.04em] text-balance md:text-[72px] md:leading-[1.01]"
          >
            Read email like chat.
            <span class="mt-1 block text-muted-foreground md:mt-2">
              Keep your mail where it is.
            </span>
          </h1>

          <p
            class="rise-late mt-6 max-w-2xl text-[15px] leading-7 text-muted-foreground md:text-lg md:leading-8"
          >
            Nuntia puts Gmail and Outlook in one inbox, shows each thread as a
            conversation, and sorts it into what needs you. AI is optional, runs on
            your own key, and never sends anything. Your own agent can now read and
            triage the same mail over MCP.
          </p>

          <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
            <a
              href={`${appUrl}/request-access`}
              class="inline-flex h-11 items-center gap-2 rounded-[4px] bg-white px-6 text-sm font-medium text-[#0a0a0c] transition-colors hover:bg-white/90"
            >
              Request early access
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="#how"
              class="inline-flex h-11 items-center gap-2 rounded-[4px] border border-border px-6 font-mono text-[11px] tracking-[0.12em] text-foreground uppercase transition-colors hover:bg-muted"
            >
              See how it works
            </a>
          </div>

          <p
            class="mt-6 font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase"
          >
            Invite only · No price yet · Nothing sent without you
          </p>
        </div>

        <HeroVisual client:load />
      </section>

      <!-- What it is -->
      <section
        id="what"
        data-reveal
        class="border-b border-border px-5 py-16 md:px-12 md:py-24"
      >
        <div class="mx-auto max-w-7xl">
          <div class="grid gap-10 md:grid-cols-12 md:gap-14">
            <div class="md:col-span-5">
              <div class="flex flex-col gap-4">
                <h2
                  class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px] md:leading-[1.05]"
                >
                  A mail client that keeps the mailbox you already have.
                </h2>
                <p class="text-[15px] leading-7 text-muted-foreground md:text-base">
                  Nuntia reads and sends through Gmail and Outlook. It shows each
                  thread the way a chat looks — messages one under another, oldest
                  first — and keeps a local copy so that reading and search do not
                  wait on the provider.
                </p>
                <p class="text-[15px] leading-7 text-muted-foreground md:text-base">
                  Alongside the mail it keeps a small, editable record of the people
                  you write to, because who someone is to you is not in the message
                  headers. That record is yours; the mail stays in your mailbox.
                </p>
              </div>
            </div>

            <div class="md:col-span-7">
              <dl class="border-t border-border">
                {
                  specs.map((row) => (
                    <div class="flex flex-col gap-1 border-b border-border py-3 sm:flex-row sm:gap-8">
                      <dt class="shrink-0 font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase sm:w-32">
                        {row.label}
                      </dt>
                      <dd class="text-[14px] leading-6 text-foreground/90">{row.value}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>

          <div class="mt-14 grid gap-8 md:grid-cols-3 md:gap-10">
            {
              audience.map((item) => (
                <div class="flex flex-col gap-2 border-t border-border pt-4">
                  <h3 class="font-display text-lg font-medium tracking-tight">{item.title}</h3>
                  <p class="text-[14px] leading-6 text-muted-foreground">{item.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section
        id="how"
        data-reveal
        class="border-b border-border px-5 py-16 md:px-12 md:py-24"
      >
        <div class="mx-auto max-w-7xl">
          <div class="grid gap-10 md:grid-cols-12 md:gap-14">
            <div class="md:col-span-4">
              <div class="flex flex-col gap-5 md:sticky md:top-24">
                <h2
                  class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px] md:leading-[1.05]"
                >
                  From the first sign-in to the first reply.
                </h2>
                <p class="max-w-sm text-[15px] leading-7 text-muted-foreground md:text-base">
                  Connect the mail you already have and the inbox does the sorting.
                  There are no folders to build and no filing to keep up with.
                </p>
              </div>
            </div>

            <ol class="border-t border-border md:col-span-8">
              {
                steps.map((step, index) => (
                  <li
                    data-reveal
                    style={`--reveal-delay: ${index * 80}ms`}
                    class="group grid grid-cols-[3.5rem_1fr] gap-4 border-b border-border py-7 sm:grid-cols-[7rem_1fr] sm:gap-8 md:py-9"
                  >
                    <span
                      aria-hidden="true"
                      class="font-display text-[40px] leading-none font-medium tracking-[-0.04em] text-muted-foreground/25 transition-colors duration-300 group-hover:text-primary sm:text-[56px]"
                    >
                      {step.number}
                    </span>
                    <div class="flex flex-col gap-2 pt-0.5">
                      <h3 class="font-display text-xl font-medium tracking-tight md:text-2xl">
                        {step.title}
                      </h3>
                      <p class="max-w-xl text-[14px] leading-6 text-muted-foreground md:text-[15px] md:leading-7">
                        {step.body}
                      </p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>

          <p class="mt-10 border-t border-border pt-4 font-mono text-[11px] leading-5 text-muted-foreground">
            First sync: the last 30 days · New mail: checked on a timer, or pushed
            with Gmail’s extra setup · Older mail: not fetched
          </p>
        </div>
      </section>

      <!-- Inbox -->
      <section id="features" class="divide-y divide-border border-b border-border">
        <!-- 1: stripped envelope -->
        <div data-reveal class="px-5 py-16 md:px-12 md:py-24">
          <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-12 md:gap-14">
            <div class="md:col-span-5">
              <div class="flex flex-col gap-4">
                <h2
                  class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px] md:leading-[1.05]"
                >
                  Greetings, signatures and quoted history are folded away.
                </h2>
                <p class="max-w-xl text-[15px] leading-7 text-muted-foreground md:text-base">
                  Most of a long thread is the same text repeated under a new line.
                  Nuntia removes the quoted reply, the greeting and the signature
                  when it reads, and puts your own back when you write.
                </p>
              </div>
              <ul class="mt-6 flex flex-col gap-2.5">
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>Messages in order, a divider for each day, attachments with the message they came with.</span>
                </li>
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>What was removed is still stored, and can be inspected per message.</span>
                </li>
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>Per-sender overrides when one correspondent formats mail differently.</span>
                </li>
              </ul>
            </div>

            <div class="md:col-span-7">
              <div class="rounded-[6px] border border-border bg-card p-4 md:p-6">
                <div class="flex items-center justify-between gap-3 pb-4">
                  <span class="font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase">
                    Same thread, two readings
                  </span>
                  <span class="rounded-[3px] border border-border px-1.5 py-0.5 font-mono text-[11px] text-muted-foreground">
                    original untouched
                  </span>
                </div>
                <div class="grid gap-3 sm:grid-cols-2">
                  <div class="rounded-[4px] border border-border bg-background/60 p-3">
                    <p class="font-mono text-[11px] tracking-[0.1em] text-muted-foreground uppercase">
                      Raw email
                    </p>
                    <div class="mt-3 flex flex-col gap-2 font-mono text-[11px] leading-5 text-muted-foreground/70">
                      <span>Hi Priya,</span>
                      <span class="text-foreground/70">Could you resend the signed NDA? The copy I have is missing schedule 2.</span>
                      <span class="border-l border-border pl-2">
                        &gt; On Tue, 3 Nov, you wrote:<br />
                        &gt; &gt; I’ll send it over today.<br />
                        &gt; &gt; Sent from my phone
                      </span>
                      <span class="truncate border-t border-border pt-2 text-[11px]">
                        Priya Raman | Operations, Northwind
                      </span>
                      <span class="truncate text-[11px]">
                        CONFIDENTIALITY NOTICE: this transmission…
