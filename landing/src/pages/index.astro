---
/**
 * The landing page.
 *
 * Layout from `stitch/` (hero with a workbench, four alternating feature rows,
 * principles, FAQ, closing call to action), copy from
 * `docs/landing-page-info.md`. Everything here is static HTML; the only island
 * is the hero visual, because it is the only thing that responds to a click.
 *
 * The page deliberately leaves out the mock-up's badges (SOC 2, "zero
 * training"), because the product has neither, and it does not call anything
 * "real-time", "end-to-end encrypted" or "free forever".
 */
import '../styles/global.css'
import HeroVisual from '../components/HeroVisual'

const appUrl = (import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:3000').replace(
  /\/$/,
  '',
)

const steps = [
  {
    number: '01',
    title: 'Connect a mailbox',
    body: 'Sign in with Google or Microsoft and approve read and send access. Nuntia brings in the last thirty days and keeps a local copy so reading and search are quick.',
  },
  {
    number: '02',
    title: 'Let the rules sort',
    body: 'Built-in rules put each thread in one of four states. If you add an AI key, it can score importance and pick up the cases the rules cannot decide.',
  },
  {
    number: '03',
    title: 'Reply when you are ready',
    body: 'Your greeting, signature and the quoted original come back automatically. A suggested draft waits in the box for you to edit — nothing is sent on its own.',
  },
]

const triage = [
  {
    state: 'Needs action',
    what: 'Ana asked for the monthly update',
    tone: 'border-primary/40 bg-primary/10 text-primary',
  },
  {
    state: 'Waiting for reply',
    what: 'Invoice sent, payment in thirty days',
    tone: 'border-warning/40 bg-warning/10 text-warning',
  },
  {
    state: 'Information',
    what: 'Design notes, no decision needed',
    tone: 'border-border bg-muted text-muted-foreground',
  },
  {
    state: 'Low priority',
    what: 'A newsletter you keep for later',
    tone: 'border-border bg-muted text-muted-foreground/70',
  },
]

const searchHits = [
  { subject: 'Seed round — monthly update', who: 'Ana de Vries', tag: 'investor' },
  { subject: 'Board pack v3 (draft)', who: 'Me', tag: 'internal' },
  { subject: 'Q3 numbers from the accountant', who: 'Piet Bakker', tag: 'supplier' },
]

const faqs = [
  {
    question: 'Which mail accounts work?',
    answer:
      'Gmail and Outlook — a personal Outlook.com address or a Microsoft 365 work account. You can connect more than one, from either service, and read them in one inbox. Mail from another provider is not supported.',
  },
  {
    question: 'Where does my mail live?',
    answer:
      'Your provider keeps the original. Nuntia keeps a copy in one file on the machine where it runs, which is what makes search and reading fast. Google or Microsoft sign-ins and AI keys are stored locked. Nuntia asks for read and send access and cannot delete mail.',
  },
  {
    question: 'Does it ever send without me?',
    answer:
      'No. A suggested reply is placed in the reply box for you to edit, and it is not saved anywhere. There is no automatic reply and no scheduled send.',
  },
  {
    question: 'Do I need an AI key?',
    answer:
      'No. Without one, Nuntia still sorts mail by its built-in rules and reply composition works fully. With a key from Anthropic, OpenAI or Google, it can also score importance, name topics, keep notes on people, suggest tags, draft tag descriptions and propose replies.',
  },
  {
    question: 'Can I run it myself?',
    answer:
      'Yes. The project ships as a Docker image and needs a small app registration with Google or Microsoft so those services accept the connection. The first sync brings in the last thirty days, and new mail is checked on a timer.',
  },
  {
    question: 'What does it not do yet?',
    answer:
      'No other mail providers, no spam handling or deleted-mail view, no phone or desktop app, and no shared workspace for a team. There is no calendar, no contact import from Google or Microsoft, no scheduled sending and no automatic replies.',
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nuntia — read email like chat</title>
    <meta
      name="description"
      content="Nuntia is a private-beta mail client for Gmail and Outlook: one inbox, threads as conversations, four states that say what needs you, tags for the people you write to, and optional AI drafts you review. Nothing is sent without you."
    />
    <meta property="og:title" content="Nuntia — read email like chat" />
    <meta
      property="og:description"
      content="One inbox for Gmail and Outlook. Threads as conversations, four states, people you can tag, and AI drafts you approve."
    />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="dark" />
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </head>

  <body>
    <header
      id="site-header"
      class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur-sm"
    >
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 md:px-12">
        <a href="/" class="flex items-center gap-2.5" aria-label="Nuntia home">
          <span
            aria-hidden="true"
            class="flex size-[30px] items-center justify-center rounded-[6px] bg-primary font-display text-[15px] font-bold text-primary-foreground"
          >
            N
          </span>
          <span class="font-display text-xl font-semibold tracking-tight">Nuntia</span>
          <span
            class="ml-1 hidden rounded-[3px] border border-border px-1.5 py-0.5 font-mono text-[10px] tracking-[0.1em] text-muted-foreground uppercase sm:inline"
          >
            beta
          </span>
        </a>

        <nav
          aria-label="Landing"
          class="hidden items-center gap-7 font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase md:flex"
        >
          <a class="transition-colors hover:text-foreground" href="#how">How it works</a>
          <a class="transition-colors hover:text-foreground" href="#features">Features</a>
          <a class="transition-colors hover:text-foreground" href="#tags">Tags</a>
          <a class="transition-colors hover:text-foreground" href="#faq">FAQ</a>
        </nav>

        <div class="flex items-center gap-2">
          <a
            href={`${appUrl}/sign-in`}
            class="hidden h-9 items-center px-3 font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase transition-colors hover:text-foreground sm:inline-flex"
          >
            Sign in
          </a>
          <a
            href={`${appUrl}/request-access`}
            class="inline-flex h-9 items-center gap-2 rounded-[4px] bg-white px-4 text-[13px] font-medium text-[#0a0a0c] transition-colors hover:bg-white/90"
          >
            Request access
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section
        class="relative overflow-hidden border-b border-border px-5 pt-16 pb-14 md:px-12 md:pt-24 md:pb-20"
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-[420px] max-w-4xl bg-[radial-gradient(ellipse_at_top,rgba(255,87,34,0.16),rgba(255,160,0,0.05)_45%,transparent_70%)]"
        >
        </div>

        <div class="mx-auto flex max-w-5xl flex-col items-center text-center">
          <p
            class="rise flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.14em] text-muted-foreground uppercase"
          >
            <span aria-hidden="true" class="size-1.5 rounded-full bg-primary"></span>
            Private beta · Gmail + Outlook
          </p>

          <h1
            class="rise-late mt-6 max-w-4xl font-display text-[40px] leading-[1.03] font-semibold tracking-[-0.04em] text-balance md:text-[72px] md:leading-[1.01]"
          >
            Read email like chat.
            <span class="mt-1 block text-muted-foreground md:mt-2">
              Keep your mail where it is.
            </span>
          </h1>

          <p
            class="rise-late mt-6 max-w-2xl text-[15px] leading-7 text-muted-foreground md:text-lg md:leading-8"
          >
            Nuntia puts Gmail and Outlook in one inbox, shows each thread as a
            conversation, and sorts it into what needs you. AI is optional, runs on
            your own key, and never sends anything.
          </p>

          <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
            <a
              href={`${appUrl}/request-access`}
              class="inline-flex h-11 items-center gap-2 rounded-[4px] bg-white px-6 text-sm font-medium text-[#0a0a0c] transition-colors hover:bg-white/90"
            >
              Request early access
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="#how"
              class="inline-flex h-11 items-center gap-2 rounded-[4px] border border-border px-6 font-mono text-[11px] tracking-[0.12em] text-foreground uppercase transition-colors hover:bg-muted"
            >
              See how it works
            </a>
          </div>

          <p
            class="mt-6 font-mono text-[10px] tracking-[0.12em] text-muted-foreground uppercase"
          >
            Invite only · No price yet · Nothing sent without you
          </p>
        </div>

        <HeroVisual client:load />
      </section>

      <!-- How it works -->
      <section
        id="how"
        data-reveal
        class="border-b border-border px-5 py-16 md:px-12 md:py-24"
      >
        <div class="mx-auto max-w-7xl">
          <p
            class="flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.14em] text-muted-foreground uppercase"
          >
            <span aria-hidden="true" class="size-1.5 rounded-full bg-warning"></span>
            How it works
          </p>
          <div class="mt-4 grid gap-8 md:grid-cols-3 md:gap-10">
            {
              steps.map((step, index) => (
                <div
                  data-reveal
                  style={`--reveal-delay: ${index * 80}ms`}
                  class="flex flex-col gap-3 border-t border-border pt-5"
                >
                  <span class="font-mono text-[11px] tracking-[0.12em] text-muted-foreground">
                    {step.number}
                  </span>
                  <h3 class="font-display text-xl font-medium tracking-tight">
                    {step.title}
                  </h3>
                  <p class="text-[14px] leading-6 text-muted-foreground">{step.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Features -->
      <section id="features" class="divide-y divide-border border-b border-border">
        <!-- 1: stripped envelope -->
        <div data-reveal class="px-5 py-16 md:px-12 md:py-24">
          <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-12 md:gap-14">
            <div class="md:col-span-5">
              <div class="flex flex-col gap-4">
                <p
                  class="flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.14em] text-muted-foreground uppercase"
                >
                  <span aria-hidden="true" class="size-1.5 rounded-full bg-primary"></span>
                  The message, not the envelope
                </p>
                <h2
                  class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px] md:leading-[1.05]"
                >
                  Quoted history, greetings and signatures get out of the way.
                </h2>
                <p class="max-w-xl text-[15px] leading-7 text-muted-foreground md:text-base">
                  Most of a long thread is the same text repeated under a new line.
                  Nuntia removes the quoted reply, the greeting and the signature
                  when it reads, and puts yours back when you write.
                </p>
              </div>
              <ul class="mt-6 flex flex-col gap-2.5">
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>Read the newest message without scrolling past three copies of it.</span>
                </li>
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>Your greeting and signature return on send, in your own words.</span>
                </li>
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>Per-sender rules when one correspondent formats mail differently.</span>
                </li>
              </ul>
            </div>

            <div class="md:col-span-7">
              <div class="rounded-lg border border-border bg-card p-4 md:p-6">
                <div class="flex items-center justify-between gap-3 pb-4">
                  <span class="font-mono text-[10px] tracking-[0.12em] text-muted-foreground uppercase">
                    Same thread, two readings
                  </span>
                  <span class="rounded-[3px] border border-border px-1.5 py-0.5 font-mono text-[9px] text-muted-foreground">
                    original untouched
                  </span>
                </div>
                <div class="grid gap-3 sm:grid-cols-2">
                  <div class="rounded-[6px] border border-border bg-background/60 p-3">
                    <p class="font-mono text-[9px] tracking-[0.1em] text-muted-foreground uppercase">
                      Raw email
                    </p>
                    <div class="mt-3 flex flex-col gap-2 font-mono text-[10px] leading-5 text-muted-foreground/70">
                      <span>Hope this finds you well.</span>
                      <span class="text-foreground/70">Can we move the review to Thursday?</span>
                      <span class="border-l border-border pl-2">
                        &gt; On Monday, you wrote:<br />
                        &gt; &gt; Can we keep the Tuesday slot?<br />
                        &gt; &gt; Sent from my phone
                      </span>
                      <span class="truncate border-t border-border pt-2 text-[9px]">
                        CONFIDENTIALITY NOTICE: this transmission…
                      </span>
                    </div>
                  </div>

                  <div class="rounded-[6px] border border-primary/25 bg-primary/[0.04] p-3">
                    <p class="font-mono text-[9px] tracking-[0.1em] text-primary uppercase">
                      Nuntia
                    </p>
                    <div class="mt-3 flex flex-col gap-2">
                      <div class="rounded-[4px] bg-muted/60 p-2">
                        <p class="text-[10px] font-medium text-primary">David Chen</p>
                        <p class="text-[12px] leading-5">Can we move the review to Thursday?</p>
                      </div>
                      <div
                        class="flex items-center gap-1.5 rounded-[3px] border border-border px-2 py-1 font-mono text-[9px] text-muted-foreground"
                      >
                        <span aria-hidden="true" class="size-1.5 rounded-full bg-success"></span>
                        Quoted reply, greeting and signature folded away
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2: states -->
        <div data-reveal class="px-5 py-16 md:px-12 md:py-24">
          <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-12 md:gap-14">
            <div class="order-2 md:order-1 md:col-span-7">
              <div class="rounded-lg border border-border bg-card p-4 md:p-6">
                <div class="flex items-center justify-between gap-3 pb-4">
                  <span class="font-mono text-[10px] tracking-[0.12em] text-muted-foreground uppercase">
                    Triage
                  </span>
                  <span class="font-mono text-[9px] text-muted-foreground">four states, always</span>
                </div>
                <div class="flex flex-col gap-2">
                  {
                    triage.map((row) => (
                      <div class="flex flex-wrap items-center gap-2 rounded-[6px] border border-border bg-background/40 px-3 py-2.5">
                        <span
                          class={`rounded-[3px] border px-1.5 py-0.5 font-mono text-[9px] tracking-[0.08em] uppercase ${row.tone}`}
                        >
                          {row.state}
                        </span>
                        <span class="text-[12px] text-foreground/80">{row.what}</span>
                      </div>
                    ))
                  }
                </div>
                <p class="mt-4 border-t border-border pt-3 font-mono text-[9px] text-muted-foreground">
                  Rename the states, explain what they mean, add sections of your own.
                </p>
              </div>
            </div>

            <div class="order-1 md:order-2 md:col-span-5">
              <div class="flex flex-col gap-4">
                <p
                  class="flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.14em] text-muted-foreground uppercase"
                >
                  <span aria-hidden="true" class="size-1.5 rounded-full bg-primary"></span>
                  Sorted by what it needs
                </p>
                <h2
                  class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px] md:leading-[1.05]"
                >
                  Four states that answer one question: does this need me?
                </h2>
                <p class="max-w-xl text-[15px] leading-7 text-muted-foreground md:text-base">
                  Folders collect mail. States answer a question. Every thread lands in
                  exactly one of four places, and you can rename them and write what each
                  one means to you.
                </p>
              </div>
              <ul class="mt-6 flex flex-col gap-2.5">
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>Needs action, waiting for reply, information, low priority — your wording, your meaning.</span>
                </li>
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>Your own sections for a client, a project, or anything worth more than one label.</span>
                </li>
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>Done moves a thread out of the way; a new message brings it back.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- 3: search -->
        <div data-reveal class="px-5 py-16 md:px-12 md:py-24">
          <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-12 md:gap-14">
            <div class="md:col-span-5">
              <div class="flex flex-col gap-4">
                <p
                  class="flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.14em] text-muted-foreground uppercase"
                >
                  <span aria-hidden="true" class="size-1.5 rounded-full bg-primary"></span>
                  One search, every mailbox
                </p>
                <h2
                  class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px] md:leading-[1.05]"
                >
                  Find the thread you half remember.
                </h2>
                <p class="max-w-xl text-[15px] leading-7 text-muted-foreground md:text-base">
                  Search runs over every message Nuntia has saved — subject, topic, the
                  people on the thread and the text itself. It works across all your
                  connected addresses at once, and it does not wait on the mail provider.
                </p>
              </div>
              <ul class="mt-6 flex flex-col gap-2.5">
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>One box for Gmail and Outlook, together.</span>
                </li>
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>Results as you type, including mail filed under Done.</span>
                </li>
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
                  <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                  <span>Attachments stay with the message they arrived on.</span>
                </li>
              </ul>
            </div>

            <div class="md:col-span-7">
              <div class="rounded-lg border border-border bg-card p-4 md:p-6">
                <div
                  class="flex items-center gap-2 rounded-[4px] border border-border bg-background/60 px-3 py-2"
                >
                  <svg
                    aria-hidden="true"
                    class="size-3.5 text-muted-foreground"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  >
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m17 17 4 4"></path>
                  </svg>
                  <span class="text-[12px] text-foreground/80">retention numbers</span>
                  <span aria-hidden="true" class="ml-auto h-4 w-px animate-pulse bg-primary"></span>
                </div>
                <div class="mt-3 flex flex-col divide-y divide-border">
                  {
                    searchHits.map((hit) => (
                      <div class="flex items-center gap-2 py-2.5">
                        <span class="min-w-0 flex-1">
                          <span class="block truncate text-[12px] text-foreground/90">
                            {hit.subject}
                          </span>
                          <span class="block truncate text-[11px] text-muted-foreground">
                            {hit.who}
                          </span>
                        </span>
                        <span class="rounded-[3px] border border-border bg-muted px-1.5 py-0.5 font-mono text-[9px] tracking-[0.08em] text-muted-foreground uppercase">
                          {hit.tag}
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 4: outbound -->
        <div data-reveal class="px-5 py-16 md:px-12 md:py-24">
          <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-12 md:gap-14">
            <div class="order-2 md:order-1 md:col-span-7">
              <div class="rounded-lg border border-border bg-card p-4 md:p-6">
                <div class="flex items-center justify-between gap-3 pb-4">
                  <span class="font-mono text-[10px] tracking-[0.12em] text-muted-foreground uppercase">
                    What you type
                  </span>
                  <span class="font-mono text-[9px] text-muted-foreground">
                    what they receive
                  </span>
                </div>
                <div class="rounded-[6px] border border-border bg-background/60 p-3">
                  <p class="text-[13px] leading-6">
                    Sure — pushed it to staging. Let me know when you have looked at the
                    logs.
                  </p>
                </div>
                <div class="flex justify-center py-2">
                  <span aria-hidden="true" class="text-muted-foreground">↓</span>
                </div>
                <div class="rounded-[6px] border border-primary/25 bg-primary/[0.04] p-3">
                  <p class="text-[13px] leading-6 text-foreground/90">
                    Hi Elena,<br /><br />
                    Sure — I have pushed the code to staging. Let me know once you have
                    reviewed the logs so we can continue with the release.<br /><br />
                    Best regards,<br />
                    Alex
                  </p>
                  <p class="mt-3 border-t border-border pt-2 font-mono text-[9px] text-muted-foreground">
                    Your greeting and signature, added on the way out.
                  </p>
                </div>
              </div>
            </div>

            <div class="order-1 md:order-2 md:col-span-5">
              <div class="flex flex-col gap-4">
                <p
                  class="flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.14em] text-muted-foreground uppercase"
                >
                  <span aria-hidden="true" class="size-1.5 rounded-full bg-primary"></span>
                  Still ordinary email
                </p>
                <h2
                  class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px] md:leading-[1.05]"
                >
                  Write quickly. It leaves as email.
                </h2>
                <p class="max-w-xl text-[15px] leading-7 text-muted-foreground md:text-base">
                  The person you are writing to does not need a new app. Replies carry
                  your greeting, your signature and the message you are answering,
                  because the recipient is reading normal mail in Gmail or Outlook.
                </p>
              </div>
              <ul class="mt-6 flex flex-col gap-2.5">
                <li class="flex gap-3 text-[14px] leading-6 text-foreground/90">
