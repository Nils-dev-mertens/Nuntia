                  data-reveal
                  style={`--reveal-delay: ${index * 80}ms`}
                  class="flex flex-col justify-between gap-6 border border-border bg-card p-6 transition-[border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-primary/40"
                >
                  <div>
                    <p class="flex items-center gap-2 font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase">
                      <span aria-hidden="true" class={`size-1.5 ${card.accent}`}></span>
                      {card.label}
                    </p>
                    <h3 class="mt-3 font-display text-xl font-medium tracking-tight">
                      {card.title}
                    </h3>
                    <p class="mt-2 text-[14px] leading-6 text-muted-foreground">{card.body}</p>
                  </div>
                  <p class="border-t border-border pt-3 font-mono text-[11px] tracking-[0.06em] text-muted-foreground uppercase">
                    {card.footnote}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Agents -->
      <section
        id="agents"
        data-reveal
        class="relative overflow-hidden border-b border-border px-5 py-16 md:px-12 md:py-24"
      >
        <div class="relative mx-auto max-w-7xl">
          <div class="grid gap-10 md:grid-cols-12 md:gap-14">
            <div class="md:col-span-5">
              <div class="flex flex-col gap-4">
                <h2
                  class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px] md:leading-[1.05]"
                >
                  Your inbox, in the agent you already use.
                </h2>
                <p class="max-w-xl text-[15px] leading-7 text-muted-foreground md:text-base">
                  Nuntia runs an MCP server beside the app. Connect Claude Code, Cursor,
                  VS Code, Vibe or another MCP client and ask in your own words: it
                  searches the same threads, reads the same notes and makes the same
                  triage changes you would.
                </p>
                <p class="max-w-xl text-[15px] leading-7 text-muted-foreground md:text-base">
                  It works from the mail Nuntia has already synced — the agent has no
                  provider login, runs no second sync, and cannot read attachment contents.
                  Every write appears in Nuntia and can be undone. Sending is the exception:
                  the agent can prepare the reply, but it leaves only after you approve the
                  exact body.
                </p>
              </div>

              <ol class="mt-6 flex flex-col border-t border-border">
                {
                  agentSteps.map((step, index) => (
                    <li class="flex gap-4 border-b border-border py-3">
                      <span class="font-mono text-[11px] text-muted-foreground">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="text-[14px] leading-6 text-foreground/90">{step}</span>
                    </li>
                  ))
                }
              </ol>

              <div class="mt-5">
                <p class="font-mono text-[10px] tracking-[0.12em] text-muted-foreground uppercase">
                  Works with
                </p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {
                    agentClients.map((client) => (
                      <span class="rounded-[3px] border border-border bg-card px-2 py-1 font-mono text-[10px] text-foreground/80">
                        {client}
                      </span>
                    ))
                  }
                </div>
                <p class="mt-2 text-[12px] leading-5 text-muted-foreground">
                  Any client that speaks Streamable HTTP. Claude Desktop connects
                  through the mcp-remote bridge.
                </p>
              </div>

            </div>

            <div class="md:col-span-7">
              <div class="overflow-hidden rounded-[6px] border border-border bg-card">
                <div
                  class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-3 md:px-6"
                >
                  <span
                    class="font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase"
                  >
                    Agent session · Claude Code
                  </span>
                  <span
                    class="flex items-center gap-1.5 rounded-[3px] border border-border px-1.5 py-0.5 font-mono text-[11px] text-muted-foreground"
                  >
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-success"></span>
                    connected · loopback
                  </span>
                </div>

                <div class="p-4 md:px-6 md:py-5">
                  <div class="rounded-[4px] border border-border bg-background/60 p-3">
                    <p class="font-mono text-[11px] tracking-[0.1em] text-muted-foreground uppercase">
                      You
                    </p>
                    <p class="mt-2 text-[13px] leading-6 text-foreground/90">
                      Find anything from Northwind that still needs an answer, and draft a
                      reply for each.
                    </p>
                  </div>

                  <div class="mt-3 flex flex-col gap-2">
                    {
                      agentTools.map((tool) => (
                        <div class="rounded-[4px] border border-border bg-background/40 px-3 py-2">
                          <div class="flex items-center justify-between gap-3">
                            <span class="flex min-w-0 items-center gap-1.5 font-mono text-[11px] text-foreground/80">
                              <span
                                aria-hidden="true"
                                class="size-1.5 shrink-0 rounded-full bg-primary"
                              >
                              </span>
                              <span class="truncate">{tool.name}</span>
                            </span>
                            <span class="shrink-0 font-mono text-[11px] text-muted-foreground">
                              {tool.result}
                            </span>
                          </div>
                          <p class="mt-1 truncate font-mono text-[11px] leading-5 text-muted-foreground">
                            {tool.detail}
                          </p>
                        </div>
                      ))
                    }
                  </div>

                  <div class="mt-3 rounded-[4px] border border-primary/25 bg-primary/[0.04] p-3">
                    <p class="text-[13px] leading-6 text-foreground/90">
                      Two threads still need an answer — the NDA from Priya Raman and the
                      Q1 retainer. I have drafts for both; nothing has been sent.
                    </p>
                  </div>

                  <div class="mt-3 rounded-[4px] border border-warning/25 bg-warning/[0.05] p-3">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <span
                        class="flex items-center gap-1.5 font-mono text-[11px] tracking-[0.08em] text-warning uppercase"
                      >
                        <span aria-hidden="true" class="size-1.5 rounded-full bg-warning"></span>
                        Send gate
                      </span>
                      <span class="font-mono text-[10px] text-muted-foreground">
                        send_reply · confirm: true
                      </span>
                    </div>
                    <p class="mt-2 text-[13px] leading-6 text-foreground/90">
                      A draft is only text. The reply leaves after you approve the exact
                      body and the agent calls the send tool a second time.
                    </p>
                  </div>
                </div>

                <div class="border-t border-border bg-background/50 px-4 py-4 md:px-6">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <p class="font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase">
                      Connect
                    </p>
                    <p class="font-mono text-[10px] text-muted-foreground">
                      JSON · Cursor, VS Code, Vibe
                    </p>
                  </div>
                  <pre
                    class="mt-3 overflow-x-auto rounded-[4px] border border-border bg-background/70 p-3 font-mono text-[11px] leading-5 text-foreground/80"
                  ><code>{agentConfig}</code></pre>
                  <p class="mt-2 font-mono text-[10px] leading-5 text-muted-foreground">
                    The token is filled in for you; the Claude Code command and Claude
                    Desktop bridge are in the same panel.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-14 border-t border-border pt-8">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase">
                  What an agent can do
                </p>
                <h3
                  class="mt-2 font-display text-2xl font-medium tracking-[-0.02em] text-balance md:text-[28px]"
                >
                  Twelve tools, one boundary.
                </h3>
              </div>
              <p class="max-w-sm text-[13px] leading-6 text-muted-foreground">
                The same ownership checks, state rules and reply composition the browser
                uses. The agent gets no separate database and no wider access.
              </p>
            </div>

            <div class="mt-7 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
              {
                agentCards.map((card) => (
                  <div
                    class={`flex flex-col gap-1.5 border-t pt-4 ${
                      card.label === 'Send' ? 'border-primary/40' : 'border-border'
                    }`}
                  >
                    <span
                      class={`font-mono text-[11px] tracking-[0.12em] uppercase ${
                        card.label === 'Send' ? 'text-primary' : 'text-muted-foreground'
                      }`}
                    >
                      {card.label}
                    </span>
                    <p class="font-mono text-[10px] leading-4 text-muted-foreground/80">
                      {card.tools}
                    </p>
                    <h4 class="mt-1 font-display text-lg font-medium tracking-tight">
                      {card.title}
                    </h4>
                    <p class="text-[14px] leading-6 text-muted-foreground">{card.body}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="mt-10 grid gap-4 border-t border-border pt-6 sm:grid-cols-2 lg:grid-cols-4">
            {
              agentFacts.map(([label, value]) => (
                <div class="flex flex-col gap-1">
                  <span class="font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase">
                    {label}
                  </span>
                  <span class="text-[13px] leading-5 text-foreground/90">{value}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Privacy -->
      <section
        id="privacy"
        data-reveal
        class="border-b border-border px-5 py-16 md:px-12 md:py-24"
      >
        <div class="mx-auto max-w-7xl">
          <div class="max-w-2xl">
            <h2
              class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px]"
            >
              What is stored, what is locked, and what leaves.
            </h2>
            <p class="mt-4 text-[15px] leading-7 text-muted-foreground">
              These are properties of how the app works, not promises about how it feels.
              They are also what the beta measures itself against.
            </p>
          </div>

          <div class="mt-10 grid gap-4 md:grid-cols-3">
            {
              privacyCards.map((card, index) => (
                <div
                  data-reveal
                  style={`--reveal-delay: ${index * 80}ms`}
                  class="flex flex-col justify-between gap-6 border border-border bg-card p-6 transition-[border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-primary/40"
                >
                  <div>
                    <span aria-hidden="true" class={`block size-2 ${card.accent}`}></span>
                    <h3 class="mt-4 font-display text-xl font-medium tracking-tight">
                      {card.title}
                    </h3>
                    <p class="mt-2 text-[14px] leading-6 text-muted-foreground">{card.body}</p>
                  </div>
                  <p class="border-t border-border pt-3 font-mono text-[11px] tracking-[0.06em] text-muted-foreground uppercase">
                    {card.footnote}
                  </p>
                </div>
              ))
            }
          </div>

          <div class="mt-4 grid gap-4 border-t border-border pt-6 sm:grid-cols-2 lg:grid-cols-4">
            {
              [
                ['Mail providers', 'Gmail and Outlook, together'],
                ['New mail', 'Timer, or Gmail push with setup'],
                ['First sync', 'The last 30 days'],
                ['Data', 'One file, backed up by the operator'],
                ['Photos', 'Initials by default; Gravatar is opt-in'],
                ['Tracking', 'None in the app; stats stay in Nuntia’s file'],
                ['Drafts', 'Not kept after you leave the reply box'],
                ['Deleting mail', 'Not possible, in Nuntia or your mailbox'],
              ].map(([label, value]) => (
                <div class="flex flex-col gap-1">
                  <span class="font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase">
                    {label}
                  </span>
                  <span class="text-[13px] leading-5 text-foreground/90">{value}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Not there yet -->
      <section
        id="limits"
        data-reveal
        class="border-b border-border bg-[#0d0d0f] px-5 py-16 md:px-12 md:py-24"
      >
        <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-12 md:gap-14">
          <div class="md:col-span-4">
            <h2
              class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px]"
            >
              Not there yet.
            </h2>
            <p class="mt-4 text-[14px] leading-6 text-muted-foreground">
              A beta is more useful when its edges are stated. This is the whole list as
              the app stands today; if one of these is the thing you need, Nuntia is not
              the tool for it yet.
            </p>
          </div>

          <ul class="md:col-span-8 sm:columns-2 sm:gap-10">
            {
              limited.map((item, index) => (
                <li
                  data-reveal
                  style={`--reveal-delay: ${index * 40}ms`}
                  class="break-inside-avoid border-t border-border py-3 text-[14px] leading-6 text-foreground/90"
                >
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Getting started -->
      <section
        id="start"
        data-reveal
        class="border-b border-border px-5 py-16 md:px-12 md:py-24"
      >
        <div class="mx-auto max-w-7xl">
          <div class="max-w-2xl">
            <h2
              class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px]"
            >
              What you need, and what happens next.
            </h2>
          </div>

          <div class="mt-10 grid gap-10 md:grid-cols-12 md:gap-14">
            <div class="md:col-span-6">
              <p class="font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase">
                The private beta
              </p>
              <ol class="mt-4 flex flex-col">
                {
                  betaSteps.map((step, index) => (
                    <li class="flex gap-4 border-t border-border py-4">
                      <span class="font-mono text-[11px] text-muted-foreground">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="text-[14px] leading-6 text-foreground/90">{step}</span>
                    </li>
                  ))
                }
              </ol>
              <p class="border-t border-border pt-4 text-[14px] leading-6 text-muted-foreground">
                No price has been set, and there is no payment step anywhere in the app.
              </p>
            </div>

            <div class="md:col-span-6">
              <p class="font-mono text-[11px] tracking-[0.12em] text-muted-foreground uppercase">
                What it takes
              </p>
              <ul class="mt-4 flex flex-col">
                {
                  needs.map((need) => (
                    <li class="flex gap-3 border-t border-border py-4 text-[14px] leading-6 text-foreground/90">
                      <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-primary"></span>
                      <span>{need}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section
        id="faq"
        data-reveal
        class="border-b border-border px-5 py-16 md:px-12 md:py-24"
      >
        <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-12 md:gap-14">
          <div class="md:col-span-4">
            <h2
              class="font-display text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance md:text-[40px]"
            >
              Plain answers.
            </h2>
            <p class="mt-4 text-[14px] leading-6 text-muted-foreground">
              If something is missing, ask in the access request — the beta exists to find
              out what is still wrong.
            </p>
          </div>

          <div class="md:col-span-8">
            <div class="divide-y divide-border border-y border-border">
              {
                faqs.map((item) => (
                  <details class="group">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left text-[15px] font-medium transition-colors hover:text-primary [&::-webkit-details-marker]:hidden">
                      {item.question}
                      <span
                        aria-hidden="true"
                        class="flex size-6 shrink-0 items-center justify-center rounded-[3px] border border-border font-mono text-muted-foreground transition-transform duration-200 group-open:rotate-45"
                      >
                        +
                      </span>
                    </summary>
                    <p class="faq-answer max-w-2xl pb-4 text-[14px] leading-6 text-muted-foreground">
                      {item.answer}
                    </p>
                  </details>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- Closing -->
      <section data-reveal class="px-5 py-16 md:px-12 md:py-20">
        {/* One column, unlike the split in the FAQ above it. The cadmium-to-amber
            gradient is the accent at full strength: it is the only block on the
            page where the two brand colours carry the whole surface. */}
        <div
          class="cta-gradient relative mx-auto flex max-w-7xl flex-col gap-8 overflow-hidden rounded-lg px-6 py-10 md:px-12 md:py-14"
        >
          <div
            aria-hidden="true"
            class="cta-orb pointer-events-none absolute -top-24 -right-16 size-72 rounded-full bg-white/15"
          >
          </div>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-[linear-gradient(90deg,rgba(10,10,12,0.28),rgba(10,10,12,0.05)_55%,transparent)]"
          >
          </div>

          <div class="relative z-10 max-w-2xl">
            <h2
              class="font-display text-[28px] leading-[1.1] font-semibold tracking-[-0.03em] text-balance text-white md:text-[40px]"
            >
              Request an invitation.
            </h2>
            <p class="mt-3 text-[15px] leading-7 text-white/90">
              Access is approved by hand. Ask for one, connect a mailbox, and see whether
              four states are enough for the way you work. No price, no card, no new
              address.
            </p>
          </div>

          <div class="relative z-10 flex flex-col gap-3 sm:flex-row">
            <a
              href={`${appUrl}/request-access`}
              class="inline-flex h-11 items-center justify-center gap-2 rounded-[4px] bg-white px-6 text-sm font-medium text-[#0a0a0c] transition-colors hover:bg-white/90"
            >
              Request access
              <span aria-hidden="true">→</span>
            </a>
            <a
              href={`${appUrl}/sign-in`}
              class="inline-flex h-11 items-center justify-center gap-2 rounded-[4px] border border-black/25 bg-black/20 px-6 text-sm font-medium text-white transition-colors hover:bg-black/30"
            >
              Sign in
            </a>
          </div>

          <p class="relative z-10 font-mono text-[11px] tracking-[0.1em] text-white/80 uppercase">
            Invite only · Gmail + Outlook · AI optional · Agents over MCP
          </p>
        </div>
      </section>
    </main>
</SiteLayout>
