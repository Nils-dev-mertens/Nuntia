    <script>
      /*
       * Two small jobs, no framework. Reveal every `[data-reveal]` element the
       * first time it enters the viewport, and let the header change once the
       * page has scrolled. Reduced motion shows everything immediately.
       */
      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
      const revealables = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal]'),
      )

      if (reducedMotion || !('IntersectionObserver' in window)) {
        revealables.forEach((node) => node.classList.add('is-visible'))
      } else {
        const revealer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add('is-visible')
              revealer.unobserve(entry.target)
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        )

        revealables.forEach((node) => revealer.observe(node))
      }

      const header = document.getElementById('site-header')
      if (header) {
        const updateHeader = () =>
          header.classList.toggle('is-scrolled', window.scrollY > 24)
        updateHeader()
        window.addEventListener('scroll', updateHeader, { passive: true })
      }
    </script>
