# Build context: source and config only. Everything here is either rebuilt in
# the image (`node_modules`, `dist`) or belongs to the host (the database, the
# environment, editor and tool state).

# Dependencies and build output
node_modules
dist
dist-ssr
.output
.cache
.tanstack

# The landing site is its own package, built in its own image. Its dependencies
# and output would otherwise be uploaded with the app's build context.
landing/node_modules
landing/dist
landing/.astro
landing/.env

# The database, its WAL sidecars, logs and backups
data
logs
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.log

# Environment — the template is committed, real values stay on the host
.env
.env.*
!.env.example

# Version control and local tooling
.git
.github
.vscode
.freebuff
tmp
